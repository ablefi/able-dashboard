# Copy to .env.local and fill in. Never commit .env.local.

# --- Branding ---
NEXT_PUBLIC_APP_NAME="Able"

# --- Sign-in ---
# Signs the dashboard's own session cookie. Long random string.
DASHBOARD_SESSION_SECRET=
# Shared-password sign-in, used while Able's backend has no /admin/login.
# When set, the login form checks this instead of the backend and shows the
# sections served by this dashboard's own server (LOCAL_PERMISSIONS in src/lib/auth.ts).
DASHBOARD_PASSWORD=
# Optional: only these emails may sign in with the shared password (comma separated).
DASHBOARD_ALLOWED_EMAILS=

# --- Able API reports (Overview, Users, Compliance, Growth, Creators, Giving) ---
# The API's read-only DASHBOARD_API_TOKEN. Server-side only; never NEXT_PUBLIC_.
API_TOKEN=
# Optional; defaults to the production API.
API_BASE=https://able-api.able.finance
# The API's scoped CREATORS_API_TOKEN: creator add/edit/remove, feed refreshes and
# post approve/exclude only. Server-side only.
CREATORS_API_TOKEN=

# --- Supabase (Website Analytics, Competitors, App Store Reviews) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APPLE_APP_ID=                    # Able's App Store id once live: pins Able in Competitors rankings

# --- Backend admin login (not built yet) ---
# Used only when DASHBOARD_PASSWORD is unset. Needs the /admin/* endpoints in the README.
NEXT_PUBLIC_BACKEND_STAGING_URL=https://api-staging.example.com
NEXT_PUBLIC_BACKEND_PRODUCTION_URL=https://api.example.com
# Hostnames that serve the PRODUCTION dashboard (comma separated). Anything else uses staging.
NEXT_PUBLIC_PRODUCTION_DASHBOARD_HOSTS=admin.example.com
# Optional hard override for one deployment (wins over the hostname rule).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Service account the dashboard's server uses to call the backend (one per backend).
ADMIN_BACKEND_USER=
ADMIN_BACKEND_USER_STAGING=
ADMIN_BACKEND_USER_PRODUCTION=
ADMIN_BACKEND_PASSWORD=
ADMIN_BACKEND_PASSWORD_STAGING=
ADMIN_BACKEND_PASSWORD_PRODUCTION=
BRAND_SELF_NAMES=able,ablefinance  # signup answers that name the app itself (attribution)
