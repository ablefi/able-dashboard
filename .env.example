# ---- Supabase (the dashboard's own marketing tables) -----------------------
# A NEW Supabase project for Able. Do not point this at any existing database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Able's backend (users, revenue) --------------------------------------
# Server-side base URL, used to mint the admin token.
BACKEND_BASE_URL=
ADMIN_BACKEND_USER=
ADMIN_BACKEND_PASSWORD=
# Same backend, inlined into the browser bundle for direct client calls.
# This one is public by design.
NEXT_PUBLIC_API_BASE_URL=

# ---- ScrapeCreators (creator post scraping) -------------------------------
# Able's own key on Able's billing. The refresh cron calls this every 8 hours.
SCRAPECREATORS_API_KEY=

# ---- RevenueCat (optional) ------------------------------------------------
# Only needed if Able uses RevenueCat. Leave blank otherwise; the revenue
# pages will render empty.
RC_API_KEY=
RC_PROJECT_ID=

# ---- Misc -----------------------------------------------------------------
# Shared secret Vercel Cron sends as a bearer token to /api/cron/*.
CRON_SECRET=
# Set to "production" to hide the staging banner.
NEXT_PUBLIC_ENV=
