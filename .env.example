# Copy to .env.local and fill in. Never commit .env.local.

# --- Branding ---
NEXT_PUBLIC_APP_NAME="Able"

# --- Sign-in ---
# Signs the dashboard's own session cookie. Long random string.
DASHBOARD_SESSION_SECRET=
# Shared-password sign-in, used while Able's backend has no /admin/login.
# When set, the login form checks this instead of the backend and shows only
# the Supabase-backed sections (Home, Creators, Website, Prospects, Competitors).
DASHBOARD_PASSWORD=
# Optional: only these emails may sign in with the shared password (comma separated).
DASHBOARD_ALLOWED_EMAILS=

# --- Able's backend (users, referral codes and admin logins) ---
# Not used in shared-password mode. Needs the /admin/* endpoints listed in the README.
NEXT_PUBLIC_BACKEND_STAGING_URL=https://api-staging.example.com
NEXT_PUBLIC_BACKEND_PRODUCTION_URL=https://api.example.com
# Hostnames that serve the PRODUCTION dashboard (comma separated). Anything else uses staging.
NEXT_PUBLIC_PRODUCTION_DASHBOARD_HOSTS=admin.example.com
# Optional hard override for one deployment (wins over the hostname rule).
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Service account the dashboard's server uses to call the backend (one per backend).
ADMIN_BACKEND_USER=
ADMIN_BACKEND_USER_STAGING=
ADMIN_BACKEND_USER_PRODUCTION=
ADMIN_BACKEND_PASSWORD=
ADMIN_BACKEND_PASSWORD_STAGING=
ADMIN_BACKEND_PASSWORD_PRODUCTION=

# --- Supabase (creators, posts, snapshots, competitors, app_state, page_views) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations ---
SCRAPECREATORS_API_KEY=          # creator post scraping (scrapecreators.com)
RC_API_KEY=                      # optional RevenueCat v2 secret key; revenue tiles stay hidden without it
RC_PROJECT_ID=
APPLE_APP_ID=                    # Able's App Store id once live: rating card and Competitors rankings
CRON_SECRET=                     # Vercel sends this as the Bearer token on cron calls

# --- Creator post auto-approval and attribution ---
# The values below are also the code defaults.
BRAND_HANDLES=able,ablefinance,able.finance   # social handles, without @
BRAND_DISPLAY_NAME="Able Finance"             # how TikTok renders a mention
BRAND_LINK_DOMAINS=able.finance               # a link to these in a description = a plug
BRAND_SELF_NAMES=able,ablefinance             # answers that name the app itself
