# Copy to .env.local and fill in. Never commit .env.local.

# --- Branding ---
NEXT_PUBLIC_APP_NAME="Able"

# --- Google Workspace sign-in (all required) ---
# Canonical origin; register this URL + /api/auth/google/callback in Google Cloud.
# Use https://YOUR-DASHBOARD-HOST in production. Never infer it from a request Host.
DASHBOARD_URL=http://localhost:3011
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate at least 32 random bytes; use different secrets for production and preview.
# Example: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=
# Optional narrower email allowlist; can never admit anyone outside @able.finance.
DASHBOARD_ALLOWED_EMAILS=
# DASHBOARD_PASSWORD and backend-admin credentials are no longer accepted.

# --- Able API reports (Overview, Users, Compliance, Growth, Creators, Giving) ---
# The API's read-only DASHBOARD_API_TOKEN. Server-side only; never NEXT_PUBLIC_.
API_TOKEN=
# Optional; defaults to the production API.
API_BASE=https://able-api.able.finance
# The API's scoped CREATORS_API_TOKEN: creator add/edit/remove, feed refreshes and
# post approve/exclude only. Server-side only.
CREATORS_API_TOKEN=

# --- Supabase (Website Analytics, Competitors, App Store Reviews) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APPLE_APP_ID=                    # Able's App Store id once live: pins Able in Competitors rankings

# --- Legacy template data-source selection (not authentication) ---
NEXT_PUBLIC_BACKEND_STAGING_URL=https://api-staging.example.com
NEXT_PUBLIC_BACKEND_PRODUCTION_URL=https://api.example.com
NEXT_PUBLIC_PRODUCTION_DASHBOARD_HOSTS=admin.example.com
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
BRAND_SELF_NAMES=able,ablefinance
